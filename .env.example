# PCE (Precision Context Engine) 环境配置
# 复制此文件为 .env 并填入实际值:
#   cp .env.example .env

# ============================================================
# LLM 提供商 (选择一种即可)
# ============================================================

# 方式一: OpenRouter (默认,支持免费额度)
# 获取 Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 方式二: StepFun 直连
# STEPFUN_API_KEY=
# PCE_MODEL=step-3.5-flash
# PCE_ANNOTATION_MODEL=step-3.5-flash

# 方式三: Anthropic Claude
# ANTHROPIC_API_KEY=
# PCE_MODEL=anthropic/claude-3-haiku-20240307
# PCE_ANNOTATION_MODEL=anthropic/claude-3-haiku-20240307

# 方式四: OpenAI
# OPENAI_API_KEY=
# PCE_MODEL=gpt-4o-mini
# PCE_ANNOTATION_MODEL=gpt-4o-mini

# ============================================================
# PCE 运行配置 (可选,均有默认值)
# ============================================================

# 目标项目根路径 (默认: 当前工作目录)
# PCE_PROJECT_PATH=/path/to/your/project

# Serena 安装路径 (默认: PCE根目录/serena,首次运行自动 clone)
# SERENA_PATH=/path/to/serena

# Serena 启动/初始化超时(秒,默认: 30)
# PCE_SERENA_TIMEOUT=120

# uv 依赖下载源(默认: https://pypi.org/simple)
# 网络受限时可切换镜像
# UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# 代理绕过(可选,仅示例)
# NO_PROXY=pypi.tuna.tsinghua.edu.cn

# 日志级别: DEBUG | INFO | WARNING | ERROR (默认: INFO)
# PCE_LOG_LEVEL=INFO

# Agent 推理模型 (默认: openrouter/stepfun/step-3.5-flash:free)
# PCE_MODEL=openrouter/stepfun/step-3.5-flash:free

# 语义注解生成模型 (默认: 同 PCE_MODEL)
# PCE_ANNOTATION_MODEL=openrouter/stepfun/step-3.5-flash:free
