# PCE (Precision Context Engine) 环境配置
# 复制此文件为 .env 并填入实际值:
#   cp .env.example .env
#
# 建议用途：
# - 本地直接运行 scripts/test_e2e.py / scripts/test_toolcall.py
# - 本地直接运行 `uv run pce serve`
# - 绕开 MCP 通道验证修改效果

# ============================================================
# LLM 最小配置
# ============================================================
# 仅需 3 个核心字段：
# 1. PCE_PROVIDER  真正的 LiteLLM provider
# 2. PCE_MODEL     该 provider 下的模型名称
# 3. PCE_BASE_URL  可选，自定义第三方中转或兼容端点
#
# 说明：
# - OpenRouter 下，PCE_MODEL 本身可以带斜杠，例如 openai/gpt-5
# - OpenAI / Anthropic 直连时，PCE_MODEL 通常就是供应商自己的模型名
# - PCE_API_KEY 仍用于统一传给 LiteLLM

# 方式一: OpenRouter
PCE_PROVIDER=openrouter
PCE_MODEL=openai/gpt-4o-mini
PCE_API_KEY=sk-or-...

# 方式二: OpenAI 直连
# PCE_PROVIDER=openai
# PCE_MODEL=gpt-4o-mini
# PCE_API_KEY=sk-...

# 方式三: Anthropic 直连
# PCE_PROVIDER=anthropic
# PCE_MODEL=claude-3-haiku-20240307
# PCE_API_KEY=sk-ant-...

# 方式四: OpenAI 兼容端点（如 vLLM / LocalAI / 第三方中转）
# PCE_PROVIDER=openai
# PCE_MODEL=your-model-name
# PCE_API_KEY=your-key
# PCE_BASE_URL=http://localhost:8000/v1

# 方式五: Anthropic 协议兼容中转
# PCE_PROVIDER=anthropic
# PCE_MODEL=claude-3-7-sonnet-latest
# PCE_API_KEY=your-key
# PCE_BASE_URL=https://your-anthropic-proxy.example.com

# 可选：同 provider 下的模型降级链，仅填写模型名部分
# PCE_MODEL_FALLBACKS=gpt-4o-mini,gpt-4.1-mini

# 可选：模型温度配置
# - PCE_TEMPERATURE 是全局总控，一旦设置会覆盖所有下游细粒度 temperature
# - 只有未设置 PCE_TEMPERATURE 时，才会读取更细粒度的专用配置
# PCE_TEMPERATURE=0.2
# PCE_AGENT_TEMPERATURE=0.2
# PCE_TOPOLOGY_TEMPERATURE=0.1
# PCE_DIGEST_TEMPERATURE=0.1
# PCE_ANNOTATION_TEMPERATURE=0.1

# ============================================================
# PCE 运行配置 (可选)
# ============================================================

# 目标项目根路径 (默认: 当前工作目录)
# PCE_PROJECT_PATH=/path/to/your/project
#
# 本地直跑时推荐显式设置为外部测试对象，例如 hicolors：
# PCE_PROJECT_PATH=/home/aiagent/Devfolder/hicolors-denoise-rebuild

# Serena 启动/初始化超时(秒,默认: 180)
# PCE_SERENA_TIMEOUT=180

# uv 依赖下载源(默认: https://pypi.org/simple)
# 网络受限时可切换镜像
# UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# 代理绕过(可选,仅示例)
# NO_PROXY=pypi.tuna.tsinghua.edu.cn

# 日志级别: DEBUG | INFO | WARNING | ERROR (默认: INFO)
# PCE_LOG_LEVEL=INFO

# 上下文窗口大小（默认: 256000）
# PCE_CONTEXT_WINDOW=256000

# 兼容别名：若已有旧配置，也可以继续使用 PCE_API_BASE
# PCE_API_BASE=http://localhost:8000/v1
